<?xml version="1.0" encoding="utf-8"?>
<!--
  晨昏圆：与首页字标左侧的 ic_brand_mark 是同一个记号——
  一个圆被地平线切成两半，上「朝」晨光、下「夕」暮色，中间一道缝透出墨底。
  两半都朝地平线一侧提亮，像光聚在那一线上。直径 62dp，落在 66dp 安全区内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <clip-path android:pathData="M54,23 A31,31 0 1,0 54,85 A31,31 0 1,0 54,23 Z" />

        <!-- 朝：晨光 -->
        <path android:pathData="M23,23 H85 V52.4 H23 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="23"
                    android:endX="54"
                    android:endY="52.4">
                    <item
                        android:color="#FFD9822B"
                        android:offset="0.0" />
                    <item
                        android:color="#FFF0B45F"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 夕：暮色 -->
        <path android:pathData="M23,55.6 H85 V85 H23 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="55.6"
                    android:endX="54"
                    android:endY="85">
                    <item
                        android:color="#FFC86C82"
                        android:offset="0.0" />
                    <item
                        android:color="#FF8F4760"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
